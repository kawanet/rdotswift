{
  "name": "rdotswift",
  "description": "iOS Swift code generator from Android app's res/values/strings.xml",
  "version": "1.2.0",
  "author": "@kawanet",
  "bin": {
    "rdotswift": "./rdotswift.cli.js"
  },
  "bugs": {
    "url": "https://github.com/kawanet/rdotswift/issues"
  },
  "dependencies": {
    "process.argv": "^1.0.0",
    "rdotjson": "^2.1.0"
  },
  "devDependencies": {
    "jshint": "^2.13.6"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "*.js",
    "src/*/*.js"
  ],
  "homepage": "https://github.com/kawanet/rdotswift#readme",
  "jshintConfig": {
    "eqeqeq": true,
    "eqnull": true,
    "esversion": 6,
    "node": true,
    "undef": true,
    "unused": true,
    "varstmt": true
  },
  "keywords": [
    "Android",
    "Java",
    "R.string",
    "Swift",
    "XML",
    "iOS"
  ],
  "license": "MIT",
  "main": "./rdotswift.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawanet/rdotswift.git"
  },
  "scripts": {
    "fixpack": "fixpack",
    "jshint": "./node_modules/.bin/jshint .",
    "prepack": "npm test",
    "test": "npm run jshint && node --test test/*.js"
  }
}
